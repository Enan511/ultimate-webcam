{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate Webcam",
  "version": "1.3.2",
  "identifier": "com.ultimatewebcam.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ultimate Webcam",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#111411"
      },
      {
        "label": "usb-prompt",
        "title": "USB Device Detected",
        "url": "prompt.html",
        "width": 420,
        "height": 210,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}